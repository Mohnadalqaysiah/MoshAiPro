# ===============================================
# MOSH AI PRO V5 - Environment Configuration
# ===============================================

# ----- Database Configuration -----
DATABASE_URL=postgresql://moshuser:moshpass@localhost:5432/moshaiprodb
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ----- API Keys -----
TWELVEDATA_API_KEY=your_twelvedata_api_key_here
FINNHUB_API_KEY=your_finnhub_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ----- Security -----
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ----- Application Settings -----
APP_NAME=Mosh AI Pro v5
APP_VERSION=5.0.0
DEBUG=True
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ----- Trading Configuration -----
ANALYSIS_INTERVAL_MINUTES=15
SUPPORTED_MARKETS=XAUUSD,BTCUSD,EURUSD,USDJPY,GBPUSD,USDCHF
DEFAULT_MARKET=XAUUSD
DEFAULT_TIMEFRAME=1h

# ----- AI Engine Settings -----
AI_CONFIDENCE_THRESHOLD=60
PREMIUM_CONFIDENCE_THRESHOLD=80
ENABLE_WYCKOFF_ANALYSIS=True
ENABLE_LIQUIDITY_ENGINE=True
ENABLE_VOLUME_INTELLIGENCE=True
ENABLE_KILLZONES=True
ENABLE_PREMIUM_DISCOUNT=True
ENABLE_BREAKER_BLOCKS=True
ENABLE_TIME_PRICE_THEORY=True

# ----- Risk Management -----
DEFAULT_RISK_PERCENTAGE=2.0
MAX_RISK_PERCENTAGE=5.0
ATR_MULTIPLIER_SL=1.5
ATR_MULTIPLIER_TP1=2.0
ATR_MULTIPLIER_TP2=3.5

# ----- Telegram Settings -----
TELEGRAM_ADMIN_IDS=123456789,987654321
TRIAL_PERIOD_DAYS=7
MAX_SIGNALS_PER_DAY=10

# ----- WebSocket Settings -----
WEBSOCKET_HEARTBEAT_INTERVAL=30
WEBSOCKET_MAX_CONNECTIONS=100

# ----- Logging -----
LOG_LEVEL=INFO
LOG_FILE_PATH=/var/log/mosh-ai-pro/app.log

# ----- Redis (for caching & real-time) -----
REDIS_URL=redis://localhost:6379/0
CACHE_EXPIRATION_SECONDS=300

# ----- External APIs Rate Limits -----
TWELVEDATA_RATE_LIMIT=8
FINNHUB_RATE_LIMIT=60
